{{- $defaultSections := slice "posts" "boardgames" "my-games" "video-games" "shaders" -}}
{{- $sections := $defaultSections -}}
{{- with site.Params.postsFeedSections -}}
  {{- if gt (len .) 0 -}}
    {{- $sections = . -}}
  {{- end -}}
{{- end -}}
{{- $pages := sort (where site.RegularPages "Section" "in" $sections) "Date" "desc" -}}
{{- $limit := 50 -}}
{{- with site.Params.postsFeedLimit -}}
  {{- if gt . 0 -}}
    {{- $limit = . -}}
  {{- end -}}
{{- end -}}
{{- $pages = first $limit $pages -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ if eq .Title .Site.Title }}{{ .Site.Title }}{{ else }}{{ with .Title }}{{ . }} — {{ end }}{{ .Site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>Recent content across posts, boardgames, video-games, shaders, and my-games on {{ .Site.Title }}</description>
    <language>{{ site.Language.LanguageCode }}</language>
    {{- with index $pages 0 }}
    <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- end }}
    <atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml" />
    {{- range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ .Summary | transform.XMLEscape }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
